        },
        "options": {}
      }
    },
    {
      "id": "0b5d2c6e-1a01-4c1e-9d51-5a3c1d0a0013",
      "name": "Anonymize video",
      "type": "n8n-nodes-blurwerk.blurwerk",
      "typeVersion": 1,
      "position": [
        780,
        20
      ],
      "parameters": {
        "operation": "anonymize",
        "binaryPropertyName": "data",
        "consentWithdrawal": false,
        "consentCheck": false,
        "wait": true,
        "maxWait": 120,
        "pollEvery": 30,
        "download": true,
        "options": {
          "audio": "keep",
          "sensitivity": "medium",
          "coverage": "medium",
          "lang": "en"
        }
      }
    },
    {
